{
  "name": "cellar-desktop",
  "productName": "Cellar",
  "version": "0.1.0",
  "private": true,
  "description": "Cellar on the pc: the app in a window, and the side of it the phone talks to — start agents, open the pc's local pages and screen, drop builds to install.",
  "main": "build/main.js",
  "scripts": {
    "build:host": "node build.mjs",
    "build": "npm run build:host && npm run renderer:build",
    "start": "npm run build && electron .",
    "dev": "node build.mjs && electron . --dev",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dist": "npm run build && electron-builder --win --x64",
    "renderer:dev": "vite",
    "renderer:build": "vite build",
    "renderer:check": "tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint src vite.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@supabase/supabase-js": "^2.110.0",
    "lucide-react": "1.23.0",
    "qrcode-generator": "2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.22.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.1.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.michaldakowicz.cellar.desktop",
    "productName": "Cellar",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "renderer-dist",
        "to": "renderer"
      },
      {
        "from": "../assets/images/icon.png",
        "to": "icon.png"
      },
      {
        "from": "vendor",
        "to": "scrcpy"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../assets/images/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
